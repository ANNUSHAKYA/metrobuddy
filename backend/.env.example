# ─── Metro Buddy Backend Environment Variables ────────────────
# Copy this file to .env and fill in values as needed.

# Server
PORT=5001
JWT_SECRET=metrobuddy_secret_dev

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── OTP Provider ─────────────────────────────────────────────
# Options: mock | msg91 | twilio
# Default: mock ($0 cost, fully functional for dev/testing)
OTP_PROVIDER=mock

# MSG91 (for Indian numbers — cheapest +91 SMS rates)
MSG91_API_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=

# Twilio Verify (for international numbers)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Redis (Upstash) — optional, for production rate limiting
# If not set, rate limiting uses in-memory store
REDIS_URL=

# ─── Email OTP Provider ───────────────────────────────────────
# Options: mock | nodemailer
# Default: mock ($0 cost — OTP printed to console + dev banner)
EMAIL_PROVIDER=mock

# Nodemailer SMTP (for real email in production)
# Gmail setup: enable 2FA → myaccount.google.com → App Passwords → generate one
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Metro Buddy <no-reply@metrobuddy.app>
